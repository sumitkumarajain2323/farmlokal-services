# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=farmlokal
DB_PASSWORD=farmlokal123
DB_NAME=farmlokal_db
DB_CONNECTION_LIMIT=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# OAuth2 Configuration
OAUTH_CLIENT_ID=your_client_id
OAUTH_CLIENT_SECRET=your_client_secret
OAUTH_TOKEN_URL=https://oauth-provider.com/token
OAUTH_SCOPE=read:products write:orders

# External APIs
EXTERNAL_API_A_URL=https://api.example.com
EXTERNAL_API_A_KEY=your_api_key
EXTERNAL_API_B_URL=https://webhook-api.example.com
EXTERNAL_API_B_SECRET=webhook_secret

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration
CACHE_TTL_PRODUCTS=300
CACHE_TTL_OAUTH_TOKEN=3600

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here